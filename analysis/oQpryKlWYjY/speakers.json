  "chapters": [
    {
      "id": "c1",
      "title": "Abstention des jeunes et pourquoi voter",
      "start": 0.0,
      "end": 190.0,
      "summary": "La journaliste ouvre le débat en interrogeant Gabriel Attal et Jordan Bardella sur les raisons d'aller voter face au risque d'abstention massive des jeunes générations."
    },
    {
      "id": "c2",
      "title": "Retraites : quel âge de départ",
      "start": 190.0,
      "end": 451.0,
      "summary": "Attal défend le passage à 65 ans porté par Macron tandis que Bardella défend le maintien à 60-62 ans de Le Pen, chacun accusant l'autre de tromper les Français."
    },
    {
      "id": "c3",
      "title": "Financement des retraites et régimes spéciaux",
      "start": 451.0,
      "end": 675.0,
      "summary": "Attal met en doute le chiffrage à 9 milliards du programme du RN et pointe le maintien des régimes spéciaux, pendant que Bardella s'appuie sur un rapport du COR pour défendre son financement."
    },
    {
      "id": "c4",
      "title": "Dette, économies et scandale McKinsey",
      "start": 675.0,
      "end": 1008.0,
      "summary": "Face à la dette publique, Bardella détaille son plan d'économies (immigration, fraude, Union européenne) tandis qu'Attal renvoie à la polémique du recours aux cabinets de conseil, y compris à la mairie de Perpignan."
    },
    {
      "id": "c5",
      "title": "Sécurité et laxisme judiciaire",
      "start": 1008.0,
      "end": 1187.0,
      "summary": "Les deux candidats s'affrontent sur le bilan sécuritaire du quinquennat, Bardella proposant présomption de légitime défense et tolérance zéro, Attal défendant les moyens supplémentaires accordés aux forces de l'ordre."
    },
    {
      "id": "c6",
      "title": "Mesure phare en 30 secondes",
      "start": 1187.0,
      "end": 1287.0,
      "summary": "Invités à présenter en 30 secondes la mesure qui changerait le quotidien des Français, Bardella met en avant la baisse de TVA sur l'énergie et Attal le versement à la source des aides sociales, avant la clôture du journal."
    }
  ]
}